// DAX measures for the LeakLens dashboard.
//
// Session Conversion Rate % divides distinct converted sessions by distinct
// product-view sessions. Counting raw events would understate conversion,
// since one session can contain many product views.
//
// Accurate Lost GMV INR takes the maximum cart value per session, so a
// session with several checkout attempts counts once. It qualifies on
// "Add to Cart", matching lost_cart_gmv_inr in sql/funnel_query.sql. An
// earlier version qualified on "Checkout Initiated", which counted a
// narrower group and disagreed with the SQL result on the same data.
//
// Lost GMV Display formats Accurate Lost GMV INR in Indian crore, because
// Power BI has no built-in lakh/crore display unit.

Session Conversion Rate % =
VAR TotalProductSessions =
    CALCULATE(
        DISTINCTCOUNT(fact_user_events[session_id]),
        fact_user_events[event_type] = "Product View"
    )
VAR ConvertedSessions =
    CALCULATE(
        DISTINCTCOUNT(fact_user_events[session_id]),
        fact_user_events[event_type] = "Payment Completed"
    )
RETURN
    DIVIDE(ConvertedSessions, TotalProductSessions, 0)


Accurate Lost GMV INR =
VAR AbandonedSessions =
    FILTER(
        VALUES(fact_user_events[session_id]),
        CALCULATE(
            COUNTROWS(fact_user_events),
            fact_user_events[event_type] = "Add to Cart"
        ) > 0
        &&
        CALCULATE(
            COUNTROWS(fact_user_events),
            fact_user_events[event_type] = "Payment Completed"
        ) = 0
    )
RETURN
    SUMX(AbandonedSessions, CALCULATE(MAX(fact_user_events[cart_value_inr])))


Lost GMV Display =
"₹" & FORMAT(DIVIDE([Accurate Lost GMV INR], 10000000), "#,##0.00") & " Cr"


Cart Abandonment Rate % =
VAR CartSessions =
    CALCULATE(
        DISTINCTCOUNT(fact_user_events[session_id]),
        fact_user_events[event_type] = "Add to Cart"
    )
VAR PaidSessions =
    CALCULATE(
        DISTINCTCOUNT(fact_user_events[session_id]),
        fact_user_events[event_type] = "Payment Completed"
    )
RETURN
    DIVIDE(CartSessions - PaidSessions, CartSessions, 0)


Total Completed GMV INR =
CALCULATE(
    SUM(fact_user_events[cart_value_inr]),
    fact_user_events[event_type] = "Payment Completed"
)